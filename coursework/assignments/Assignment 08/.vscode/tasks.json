{
    "version":  "2.0.0",
    "tasks":  [
                  {
                      "label":  "Build active C++ file (MSVC debug)",
                      "type":  "shell",
                      "command":  "${workspaceFolder}\\.vscode\\build-msvc.cmd",
                      "args":  [
                                   "${file}"
                               ],
                      "options":  {
                                      "cwd":  "${fileDirname}"
                                  },
                      "problemMatcher":  [
                                             "$msCompile"
                                         ],
                      "group":  {
                                    "kind":  "build",
                                    "isDefault":  true
                                },
                      "presentation":  {
                                           "reveal":  "always",
                                           "panel":  "shared",
                                           "clear":  true
                                       },
                      "detail":  "加载 VS2022 环境，用 /Zi /Od 编译当前文件，产物放在源文件目录。"
                  },
                  {
                      "type":  "cppbuild",
                      "label":  "C/C++: cl.exe 生成活动文件",
                      "command":  "cl.exe",
                      "args":  [
                                   "/Zi",
                                   "/EHsc",
                                   "/nologo",
                                   "/Fe${fileDirname}\\${fileBasenameNoExtension}.exe",
                                   "${file}"
                               ],
                      "options":  {
                                      "cwd":  "${fileDirname}"
                                  },
                      "problemMatcher":  [
                                             "$msCompile"
                                         ],
                      "group":  {
                                    "kind":  "build",
                                    "isDefault":  false
                                },
                      "detail":  "调试器生成的任务。"
                  }
              ]
}