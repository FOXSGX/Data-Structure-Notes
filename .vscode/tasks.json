{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cpp: 编译当前文件",
            "type": "shell",
            "command": "clang++ -std=c++17 -Wall -Wextra -g -isysroot /Library/Developer/CommandLineTools/SDKs/MacOSX15.sdk -I\"${fileDirname}\" -I\"${fileDirname}/../include\" \"${file}\" $(grep -L 'int main' \"${fileDirname}\"/*.cpp 2>/dev/null) -o a.out",
            "options": { "cwd": "${fileDirname}" },
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "cpp: 运行当前程序",
            "type": "shell",
            "command": "\"${fileDirname}/a.out\"",
            "options": { "cwd": "${fileDirname}" },
            "group": { "kind": "test", "isDefault": true },
            "problemMatcher": []
        }
    ]
}
